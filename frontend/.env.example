# Configuração local do Vite (desenvolvimento sem Docker)
# Copie este arquivo para .env.local e ajuste conforme necessário.
# O arquivo .env.local NÃO deve ser commitado no Git (já está no .gitignore padrão do Vite).

# URL do backend Laravel para o proxy do Vite
# Em desenvolvimento local (sem Docker), use localhost:8000
# Em Docker, esta variável é definida automaticamente pelo docker-compose.yml
VITE_API_URL=http://localhost:8000
