# ============================================================
# .gitignore — Frontend React + Vite
# ============================================================

# Dependências do Node (nunca versionar)
node_modules/

# Build de produção gerado pelo Vite
dist/
dist-ssr/

# ⚠️ Variáveis de ambiente locais — NUNCA commitar
.env.local
.env.*.local

# O .env.example (sem credenciais reais) PODE ser commitado

# Cache do Vite
.vite/
vite.config.ts.timestamp-*

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sistemas operacionais
.DS_Store
Thumbs.db
